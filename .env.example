# Local defaults only. Do not put secrets in this file.
APP_ENV=development
DATABASE_URL=sqlite:///./hearth_and_havoc.db
PUBLIC_API_PREFIX=/api/v1
LOG_LEVEL=INFO
# Production uses OIDC configuration supplied through the runtime secret store.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
